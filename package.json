{
  "name": "fivecrowns",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A minimal, mobile-friendly scorekeeper for Five Crowns, Greed and 500.",
  "license": "MIT",
  "homepage": "https://teh-hippo.github.io/fivecrowns/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teh-hippo/fivecrowns.git"
  },
  "bugs": {
    "url": "https://github.com/teh-hippo/fivecrowns/issues"
  },
  "engines": {
    "node": ">=22.8.0"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude='test/**'",
    "lint": "npm run lint:js && npm run lint:css && npm run format:check",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"css/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0"
  }
}

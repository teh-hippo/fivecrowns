{
  "name": "fivecrowns",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A minimal, mobile-friendly scorekeeper for Five Crowns, Greed and 500.",
  "license": "MIT",
  "homepage": "https://teh-hippo.github.io/fivecrowns/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teh-hippo/fivecrowns.git"
  },
  "bugs": {
    "url": "https://github.com/teh-hippo/fivecrowns/issues"
  },
  "engines": {
    "node": ">=22.8.0"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-lines=88 --test-coverage-branches=80 --test-coverage-functions=87",
    "lint": "npm run lint:js && npm run lint:css && npm run format:check",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"css/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0"
  }
}
